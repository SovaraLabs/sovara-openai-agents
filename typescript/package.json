{
  "name": "@sovara/openai-agents",
  "version": "0.1.0",
  "description": "Sovara recording for the OpenAI Agents SDK",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SovaraLabs/sovara-openai-agents.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/SovaraLabs/sovara-openai-agents/tree/main/typescript#readme",
  "keywords": ["sovara", "openai-agents", "observability"],
